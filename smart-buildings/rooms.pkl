open class FireDetectorRoomStateMachine extends RoomStateMachine {
	name = "fire_detector_room"
	stateMachines {
		new appliances.FireDetectorStateMachine {}
		new appliances.SirenStateMachine {}
	}
}

open class RoomStateMachine extends utility.OccupancyStateMachine {
	name = "room"
	states {
		[0] {
			entry {
				new Csml.RaiseAction {
					event {
						name = events.roomUnoccupied
						channel = "global"
					}
				}
			}
		}
		[1] {
			entry {
				new Csml.RaiseAction {
					event {
						name = events.roomOccupied
						channel = "global"
					}
				}
			}
		}
	}
}