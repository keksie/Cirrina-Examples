import "https://raw.githubusercontent.com/CollaborativeStateMachines/Cirrina/refs/heads/develop/src/main/resources/pkl/csm/Csml.pkl"

import "events.pkl"
import "appliances.pkl"

class BathroomStateMachine extends FireDetectorRoomStateMachine {
	name = "bathroom"
	stateMachines {
		new appliances.RadiatorStateMachine {}
		new appliances.LampStateMachine {}
	}
}

class HallwayStateMachine extends FireDetectorRoomStateMachine {
	name = "hallway"
	stateMachines {
		new appliances.LampStateMachine {}
		new appliances.RadiatorStateMachine {}
	}
}

class KitchenStateMachine extends RoomStateMachine {
	name = "kitchen"
	stateMachines {
		new appliances.RadiatorStateMachine {}
		new appliances.LampStateMachine {}
		new appliances.OvenStateMachine {}
		new appliances.RefrigeratorStateMachine {}
		new appliances.DishwasherStateMachine {}
	}
}

class LivingRoomStateMachine extends FireDetectorRoomStateMachine {
	name = "living_room"
	stateMachines {
		new appliances.RadiatorStateMachine {}
		new appliances.LampStateMachine {}
		new appliances.TelevisionStateMachine {}
	}
}

class BedroomStateMachine extends FireDetectorRoomStateMachine {
	name = "bedroom"
	stateMachines {
		new appliances.RadiatorStateMachine {}
		new appliances.LampStateMachine {}
		new appliances.TelevisionStateMachine {}
	}
}

class PantryStateMachine extends FireDetectorRoomStateMachine {
	name = "pantry"
	stateMachines {
		new appliances.RadiatorStateMachine {}
		new appliances.LampStateMachine {}
	}
}

open class FireDetectorRoomStateMachine extends RoomStateMachine {
	name = "fire_detector_room"
	stateMachines {
		new appliances.FireDetectorStateMachine {}
	}
}

const noPersonInRoom = new Csml.Guard {
	expression = "peopleCount == 0"
}

const incrementPeopleCount = new Csml.AssignAction {
	variable = new {
		name = "peopleCount"
		value = "peopleCount + 1"
	}
}

const decrementPeopleCount = new Csml.AssignAction {
	variable = new {
		name = "peopleCount"
		value = "peopleCount - 1"
	}
}

const resetPeopleCount = new Csml.AssignAction {
	variable = new {
		name = "peopleCount"
		value = "0"
	}
}

const raiseRoomOccupiedEvent = new Csml.RaiseAction {
	event {
		name    = events.roomOccupied
		channel = "global"
	}
}

const raiseRoomUnoccupiedEvent = new Csml.RaiseAction {
	event {
		name    = events.roomUnoccupied
		channel = "global"
	}
}

open class RoomStateMachine extends Csml.StateMachineDescription {
	name = "room"
	localContext {
		variables {
			new {
				name = "peopleCount"
				value = "0"
			}
		}
	}

	states {
		new {
			name = "unoccupied"
			initial = true
			entry {
				resetPeopleCount
				raiseRoomUnoccupiedEvent
			}
			on {
				new {
					event = events.personEnters
					target = "occupied"
				}
			}
		}
		new {
			name = "occupied"
			entry {
				incrementPeopleCount
				raiseRoomOccupiedEvent
			}
			on {
				new {
					event = events.personLeaves
					actions { decrementPeopleCount }
					target = "unoccupied"
					guards { noPersonInRoom }
				}
				new {
					event = events.personEnters
					actions { incrementPeopleCount }
				}
			}
		}
	}
}