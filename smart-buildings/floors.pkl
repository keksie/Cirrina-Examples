import "https://raw.githubusercontent.com/CollaborativeStateMachines/Cirrina/refs/heads/develop/src/main/resources/pkl/csm/Csml.pkl"

import "events.pkl"

const noPersonInFloor = new Csml.Guard {
	expression = "peopleCount == 0"
}

const incrementPeopleCount = new Csml.AssignAction {
	variable = new {
		name = "peopleCount"
		value = "peopleCount + 1"
	}
}

const decrementPeopleCount = new Csml.AssignAction {
	variable = new {
		name = "peopleCount"
		value = "peopleCount - 1"
	}
}

const resetPeopleCount = new Csml.AssignAction {
	variable = new {
		name = "peopleCount"
		value = "0"
	}
}

const raiseFloorOccupiedEvent = new Csml.RaiseAction {
	event {
		name    = events.floorOccupied
		channel = "global"
	}
}

const raiseFloorUnoccupiedEvent = new Csml.RaiseAction {
	event {
		name    = events.floorUnoccupied
		channel = "global"
	}
}

class FloorStateMachine extends Csml.StateMachineDescription {
	name = "ground_floor"
	localContext {
		variables {
			new {
				name = "floor"
				value = "0"
			}

			new {
				name = "peopleCount"
				value = "0"
			}
		}
	}

	states {
		new {
			name = "unoccupied"
			initial = true
			entry {
				resetPeopleCount
				raiseFloorUnoccupiedEvent
			}
			on {
				new {
					event = events.personEntersFloor
					target = "occupied"
				}
			}
		}

		new {
			name = "occupied"
			entry {
				incrementPeopleCount
				raiseFloorOccupiedEvent
			}
			on {
				new {
					event = events.personLeavesFloor
					actions { decrementPeopleCount }
					target = "unoccupied"
					guards { noPersonInFloor }
				}

				new {
					event = events.personEntersFloor
					actions { incrementPeopleCount }
				}
			}
		}
	}
}