import "https://raw.githubusercontent.com/CollaborativeStateMachines/Cirrina/refs/heads/develop/src/main/resources/pkl/csm/Csml.pkl"

import "events.pkl"
import "utility.pkl"

const raiseFloorOccupiedEvent = new Csml.RaiseAction {
	event {
		name    = events.floorOccupied
		channel = "global"
	}
}

const raiseFloorUnoccupiedEvent = new Csml.RaiseAction {
	event {
		name    = events.floorUnoccupied
		channel = "global"
	}
}

class FloorStateMachine extends utility.OccupancyStateMachine {
	name = "ground_floor"
	localContext {
		variables {
			new {
				name = "floor"
				value = "0"
			}
		}
	}

	states {
		[0] {
			entry {
				raiseFloorUnoccupiedEvent
			}
			on {
				[0] {
					event = events.personEntersFloor
				}
			}
		}

		[1] {
			entry {
				raiseFloorOccupiedEvent
			}
			on {
				[0] {
					event = events.personLeavesFloor
				}

				[1] {
					event = events.personEntersFloor
				}
			}
		}
	}
}