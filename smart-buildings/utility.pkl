import "https://raw.githubusercontent.com/CollaborativeStateMachines/Cirrina/refs/heads/develop/src/main/resources/pkl/csm/Csml.pkl"

import "events.pkl"
import "rooms.pkl"

const noPersonIn = new Csml.Guard {
	expression = "peopleCount == 0"
}

const incrementPeopleCount = new Csml.AssignAction {
	variable = new {
		name = "peopleCount"
		value = "peopleCount + 1"
	}
}

const decrementPeopleCount = new Csml.AssignAction {
	variable = new {
		name = "peopleCount"
		value = "peopleCount - 1"
	}
}

const resetPeopleCount = new Csml.AssignAction {
	variable = new {
		name = "peopleCount"
		value = "0"
	}
}

const state_unoccupied = new Csml.StateDescription {
	name = "unoccupied"
	initial = true
	entry {
		resetPeopleCount
	}
	on {
		new {
			event = events.personEnters
			actions { decrementPeopleCount }
			guards { noPersonIn }
			target = "unoccupied"
		}
	}
}

const state_occupied = new Csml.StateDescription {
	name = "occupied"
	on {
		new {
			event = events.personLeaves
			actions { decrementPeopleCount }
			guards { noPersonIn }
			target = "unoccupied"
		}

		new {
			event = events.personEnters
			actions { incrementPeopleCount }
			target = "occupied"
		}
	}
}

open class OccupancyStateMachine extends Csml.StateMachineDescription {
	name = "occupancy"
	localContext {
		variables {
			new {
				name = "peopleCount"
				value = "0"
			}
		}
	}
	states {
		state_unoccupied
		state_occupied		
	}
}