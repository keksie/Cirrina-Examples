import "https://raw.githubusercontent.com/CollaborativeStateMachines/Cirrina/refs/heads/develop/src/main/resources/pkl/csm/Csml.pkl"

import "radiator.pkl"
import "room.pkl"
import "lamp.pkl"

class BathroomStateMachine extends room.RoomStateMachine {
	name = "Bathroom"
	stateMachines {
		new radiator.RadiatorStateMachine {}
		new lamp.LampStateMachine {}
	}
}