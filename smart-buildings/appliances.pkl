class OvenStateMachine extends ApplianceStateMachine {
	name = "oven"
	localContext {
		variables {
			new {
				name = "temperature"
				value = "0"
			}
		}
	}
	states {
		new {
			name = "off"
			initial = true
			on {
				new {
					event = events.ovenOn
					target = "on"
				}
			}
		}
