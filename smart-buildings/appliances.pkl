import "https://raw.githubusercontent.com/CollaborativeStateMachines/Cirrina/refs/heads/develop/src/main/resources/pkl/csm/Csml.pkl"

import "events.pkl"

const lampOnAction = new Csml.InvokeActionDescription {
	serviceType = "lampOn"
}

const lampOffAction = new Csml.InvokeActionDescription {
	serviceType = "lampOff"
}

const radiatorOnAction = new Csml.InvokeActionDescription {
	serviceType = "radiatorOn"
}

const radiatorOffAction = new Csml.InvokeActionDescription {
	serviceType = "radiatorOff"
}

const sirenOnAction = new Csml.InvokeActionDescription {
	serviceType = "sirenOn"
}

const sirenOffAction = new Csml.InvokeActionDescription {
	serviceType = "sirenOff"
}

const sirenTestAction = new Csml.InvokeActionDescription {
	serviceType = "sirenTest"
}

const refrigeratorOnAction = new Csml.InvokeActionDescription {
	serviceType = "refrigeratorOn"
}

const refrigeratorOffAction = new Csml.InvokeActionDescription {
	serviceType = "refrigeratorOff"
}

class DishwasherStateMachine extends ApplianceStateMachine {
	name = "dishwasher"
	localContext {
		variables {
			new {
				name = "cycle"
				value = "0"
			}
		}
	}
	states {
		[0] {
			on {
				[0] {
					event = events.dishwasherOn
				}
			}
		}
		[1] {
			on {
				[0] {
					event = events.dishwasherOff
				}
			}
		}
	}
}

class RefrigeratorStateMachine extends ApplianceStateMachine {
	name = "refrigerator"
	localContext {
		variables {
			new {
				name = "temperature"
				value = "4"
			}
		}
	}
	states {
		[0] {
			entry { refrigeratorOffAction }
			on  = new {}
			always { // always switch fridges on if they are off
				new {
					target = "on"
				}
			}
		}
		[1] {
			entry { refrigeratorOnAction }
			on {
				[0] {
					event = events.refrigeratorOff
				}
			}
		}
	}
}

