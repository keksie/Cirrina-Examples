class TelevisionStateMachine extends ApplianceStateMachine {
	name = "television"
	localContext {
		variables {
			new {
				name = "channel"
				value = "1"
			}
		}
	}
	states {
		new {
			name = "off"
			initial = true
			on {
				new {
					event = events.tvOn
					target = "on"
				}
			}
		}
		new {
			name = "on"
			on {
				new {
					event = events.tvOff
					target = "off"
				}
			}
		}
	}
}

class FireDetectorStateMachine extends ApplianceStateMachine {
	name = "fire_detector"
	states {
		new {
			name = "normal"
			initial = true
			on {
				new {
					event = events.fireDetected
					target = "alarm"
				}
			}
		}
		new {
			name = "alarm"
			on {
				new {
					event = events.fireCleared
					target = "normal"
				}
			}
		}
	}
}

class LampStateMachine extends ApplianceStateMachine {
	name = "lamp"
	localContext {
		variables {
			new {
				name = "brightness"
				value = "100"
			}
		}
	}
	states {
		new {
			name = "off"
			initial = true
			entry { lampOffAction }
			on {
				new {
					event = events.lampOn
					target = "on"
				}
			}
		}
		new {
			name = "on"
			entry { lampOnAction }
			on {
				new {
					event = events.lampOff
					target = "off"
				}
			}
		}
	}
}

class RadiatorStateMachine extends ApplianceStateMachine {
	name = "radiator"
	localContext {
		variables {
			new {
				name = "temperature"
				value = "20"
			}
		}
	}

	states {
		new {
			name = "off"
			initial = true
			entry { radiatorOffAction }
			on {
				new {
					event = events.radiatorOn
					target = "on"
				}
			}
		}
		new {
			name = "on"
			entry { radiatorOnAction }
			on {
				new {
					event = events.radiatorOff
					target = "off"
				}
			}
		}
	}
}

open class ApplianceStateMachine extends Csml.StateMachineDescription {
	name = "appliance"
	states {
		new {
			name = "off"
			initial = true
		}

		new {
			name = "on"
		}
	}
}