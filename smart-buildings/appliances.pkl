class SirenStateMachine extends ApplianceStateMachine { // examples an addition to the appliance state machines
	name = "siren"
	states {
		[0] { // this is "off" state
			entry { sirenOffAction }
			on {
				[0] { // target "on" transition
					event = events.fireDetected
				}
				new {
					event = events.startTestFireAlarm
					target = "siren_test"
				}
			}
		}
		[1] { // this is "on" state
			entry { sirenOnAction }
			on {
				[0] { // target "off" transition
					event = events.fireCleared
				}
			}
		}
		new { // Addition to ApplianceStateMachine states
			name = "siren_test"
			entry { sirenTestAction }
			on {
				new {
					event = events.fireDetected
					target = "on"
				}
				new {
					event = events.stopTestFireAlarm
					target = "off"
				}
			}
		}
	}
}

class FireDetectorStateMachine extends ApplianceStateMachine { // examples an inplace override with an entirely new state-object
	name = "fire_detector"
	states {
		[0] = new { // this is "off" state -- with entirely new state-object (this requires all fields (no inheritance))
			name = "fire_detector_normal"
			initial = true
			on {
				new { // target "on" transition
					event = events.fireDetected
					target = "fire_detector_alarm" // overwritten name => overwrite target!
				}
			}
		}
		[1] = new { // this is "on" state -- with entirely new state-object (this requires all fields (no inheritance))
			name = "fire_detector_alarm"
			on {
				new { // target "off" transition
					event = events.fireCleared
					target = "fire_detector_normal"
				}
			}
		}
	}
}

class RadiatorStateMachine extends ApplianceStateMachine { // examples an inplace override of the states
	name = "radiator"
	localContext {
		variables {
			new {
				name = "temperature"
				value = "20"
			}
		}
	}

	states {
		[0] { // this is "off" state
			entry { radiatorOffAction }
			on {
				[0] { // target "on" transition
					event = events.radiatorOn
				}
			}
		}
		[1] { // this is "on" state
			entry { radiatorOnAction }
			on {
				[0] { // target "off" transition
					event = events.radiatorOff
				}
			}
		}
	}
}

class LampStateMachine extends ApplianceStateMachine { // examples an inplace override of the states
	name = "lamp"
	localContext {
		variables {
			new {
				name = "brightness"
				value = "100"
			}
		}
	}

	states {
		[0] { // this is "off" state
			entry { lampOffAction }
			on {
				[0] { // target "on" transition
					event = events.lampOn
				}
			}
		}
		[1] { // this is "on" state
			entry { lampOnAction }
			on {
				[0] { // target "off" transition
					event = events.lampOff
				}
			}
		}
	}
}

open class ApplianceStateMachine extends Csml.StateMachineDescription {
	name = "appliance"
	states {
		new {
			name = "off"
			initial = true
			on {
				new {
					event = "applianceOn"
					target = "on"
				}
			}
		}

		new {
			name = "on"
			on {
				new {
					event = "applianceOff"
					target = "off"
				}
			}
		}
	}
}