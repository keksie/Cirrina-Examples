import "https://raw.githubusercontent.com/CollaborativeStateMachines/Cirrina/refs/heads/develop/src/main/resources/pkl/csm/Csml.pkl"

import "events.pkl"

const lampOnAction = new Csml.InvokeActionDescription {
	serviceType = "lampOn"
}

const lampOffAction = new Csml.InvokeActionDescription {
	serviceType = "lampOff"
}

const radiatorOnAction = new Csml.InvokeActionDescription {
	serviceType = "radiatorOn"
}

const radiatorOffAction = new Csml.InvokeActionDescription {
	serviceType = "radiatorOff"
}

class DishwasherStateMachine extends ApplianceStateMachine {
	name = "dishwasher"
	localContext {
		variables {
			new {
				name = "cycle"
				value = "0"
			}
		}
	}
	states {
		new {
			name = "off"
			initial = true
			on {
				new {
					event = events.dishwasherOn
					target = "on"
				}
			}
		}
		new {
			name = "on"
			on {
				new {
					event = events.dishwasherOff
					target = "off"
				}
			}
		}
	}
}

class RefrigeratorStateMachine extends ApplianceStateMachine {
	name = "refrigerator"
	localContext {
		variables {
			new {
				name = "temperature"
				value = "4"
			}
		}
	}
	states {
		new {
			name = "off"
			initial = true
			on {
				new {
					event = events.refrigeratorOn
					target = "on"
				}
			}
		}
		new {
			name = "on"
			on {
				new {
					event = events.refrigeratorOff
					target = "off"
				}
			}
		}
	}
}

