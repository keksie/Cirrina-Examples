import "https://raw.githubusercontent.com/CollaborativeStateMachines/Cirrina/refs/heads/develop/src/main/resources/pkl/csm/Csml.pkl"

import "events.pkl"

const onAction = new Csml.InvokeActionDescription {
	serviceType = "lampOn"
}

const offAction = new Csml.InvokeActionDescription {
	serviceType = "lampOff"
}

class LampStateMachine extends Csml.StateMachineDescription {
	name = "Lamp"
	states {
		new {
			name = "off"
			initial = true
			entry { offAction }
			on {
				new {
					event = events.lampOn
					target = "on"
				}
			}
		}
		new {
			name = "on"
			entry { onAction }
			on {
				new {
					event = events.lampOff
					target = "off"
				}
			}
		}
	}
}